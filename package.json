{
  "name": "creativeotter-app",
  "version": "0.8.7",
  "private": true,
  "scripts": {
    "dev": "yarn build:ui && next dev --turbopack",
    "build": "yarn build:ui && next build",
    "start": "next start",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "prepare": "husky",
    "prettier": "prettier --write */**/*.{js,jsx,json,ts,tsx,scss,css,md}",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,css,yaml,yml}\"",
    "lint:staged": "eslint --fix",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,css,yaml,yml}\"",
    "test": "yarn build:ui && node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:native:database": "node --env-file=.env --conditions=react-server --import tsx scripts/test-native-billing.mjs",
    "test:credits:database": "node --env-file=.env --conditions=react-server --import tsx scripts/test-credits-database.mjs",
    "test:media:database": "node --env-file=.env --conditions=react-server --import tsx scripts/test-media-database.mjs",
    "test:database": "node --env-file=.env --import tsx scripts/test-database.ts",
    "db:dry-run": "node scripts/database.mjs dry-run",
    "db:push": "node scripts/database.mjs push",
    "db:list": "node scripts/database.mjs list",
    "db:configure": "node scripts/database.mjs configure",
    "test:oauth": "node --env-file=.env scripts/test-oauth.mjs",
    "build:ui": "node scripts/build-mcp-ui.mjs",
    "test:direct:database": "node --env-file=.env --conditions=react-server --import tsx scripts/test-direct-execution.mjs",
    "test:studio:database": "node --env-file=.env --conditions=react-server --import tsx scripts/test-studio-database.mjs",
    "test:studio:web": "node --env-file=.env scripts/test-studio-web.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.0.4",
    "jose": "^6.2.14",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postgres": "^4.0.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
