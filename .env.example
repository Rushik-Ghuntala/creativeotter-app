NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
NEXT_PUBLIC_APP_URL=https://creativeotter-app.vercel.app

# Keep false until fal credentials, provider pricing and a workspace budget are ready.
CREATIVEOTTER_PAID_SERVICES_ENABLED=false
# FAL_KEY=server_only_key_never_expose_to_client_or_commit

# Opt-in HTML/CSS rendering. Leave false until a dedicated worker and workspace prices are ready.
CREATIVEOTTER_RENDERING_ENABLED=false
# Optional absolute FFmpeg executable path on the worker only.
# CREATIVEOTTER_FFMPEG_PATH=/usr/bin/ffmpeg

# Optional dedicated render worker binary paths (server-only)
# CREATIVEOTTER_FFPROBE_PATH=/usr/bin/ffprobe
# HYPERFRAMES_NO_TELEMETRY=1
